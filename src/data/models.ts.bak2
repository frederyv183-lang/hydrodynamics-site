    ],
    applications: [
      "\u0420\u0435\u0433\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u043e\u0440\u043e\u0433\u0440\u0430\u0444\u0438\u0438",
