    category: "\u041c\u043e\u0434\u0435\u043b\u0438 \u043d\u0430 \u043f\u043e\u043b\u043d\u044b\u0445 \u0443\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f\u0445",
    order: 210,
    about:
