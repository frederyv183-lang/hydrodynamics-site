        caption: "\u0423\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u0435 \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u0432\u043d\u043e\u0441\u0442\u0438"
      }
    ],
    assumptions: [
